// Dev uses SQLite; production swaps provider to "postgresql" — the schema is
// written to work on both (no SQLite-only types).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Chamber {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  city        String
  state       String
  accentColor String     @default("#1E6B4F")
  businesses  Business[]
  events      Event[]
}

model Business {
  id          String        @id @default(cuid())
  chamberId   String
  chamber     Chamber       @relation(fields: [chamberId], references: [id])
  slug        String
  name        String
  category    String
  description String
  address     String
  phone       String?
  website     String?
  email       String?
  hours       String?
  tier        String        @default("basic") // basic | enhanced | featured
  status      String        @default("active") // pending | active | lapsed
  joinedAt    DateTime      @default(now())
  renewsAt    DateTime?
  jobs        Job[]
  deals       Deal[]
  views       ProfileView[]

  @@unique([chamberId, slug])
  @@index([chamberId, category])
}

model Job {
  id             String   @id @default(cuid())
  chamberId      String
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  title          String
  description    String
  type           String   @default("full_time") // full_time | part_time | contract
  payRange       String?
  applyEmail     String?
  applyUrl       String?
  status         String   @default("pending") // pending | live | closed
  isNonMemberPost Boolean @default(false)
  applicantCount Int      @default(0)
  postedAt       DateTime @default(now())
  expiresAt      DateTime?

  @@index([chamberId, status])
}

model Deal {
  id          String   @id @default(cuid())
  chamberId   String
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  title       String
  description String
  status      String   @default("pending") // pending | live | expired
  endsAt      DateTime?

  @@index([chamberId, status])
}

model Event {
  id          String   @id @default(cuid())
  chamberId   String
  chamber     Chamber  @relation(fields: [chamberId], references: [id])
  title       String
  description String
  location    String
  startsAt    DateTime
  status      String   @default("live") // pending | live — member-submitted events start pending
  submittedBy String? // businessId when member-submitted

  @@index([chamberId, startsAt])
}

// Append-only analytics feed — powers the member ROI dashboard.
model ProfileView {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  kind       String   @default("view") // view | click_website | click_call | click_directions
  occurredAt DateTime @default(now())

  @@index([businessId, occurredAt])
}
